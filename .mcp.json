{
  "mcpServers": {
    "k-stack": {
      "command": "k-stack",
      "env": {
        "KET_HOME": ".ket"
      }
    },
    "engines": {
      "command": "python3",
      "args": ["scripts/engines/engine_mcp.py"],
      "env": {
        "KET_HOME": ".ket"
      }
    },
    "harmonics": {
      "command": "python3",
      "args": ["scripts/mcp/harmonics_mcp.py"],
      "env": {
        "KET_HOME": ".ket"
      }
    }
  }
}
